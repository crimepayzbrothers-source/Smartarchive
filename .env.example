# Kopieren nach .env und anpassen:  cp .env.example .env

# Einmaliger Code für die Ersteinrichtung im Browser. Erzeugen mit:
#   openssl rand -hex 16
SETUP_TOKEN=

# Optional: KI-Einordnung über Mistral (EU). Leer lassen = nur Regeln, Verlauf und Stichwörter.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Cookies nur über HTTPS senden (Tailscale Serve liefert HTTPS). Nur für lokale Tests auf 0 setzen.
COOKIE_SECURE=1

# Maximale Dateigröße pro Upload in MB
MAX_UPLOAD_MB=40
